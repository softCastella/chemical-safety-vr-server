NODE_ENV=development
PORT=3000
ENABLE_UNAUTHENTICATED_USER_CRUD=true
ENABLE_LOCAL_TRAINING_REGISTRATION=true
LOCAL_TRAINING_DATA_FILE=./data/local-training-registrations.jsonl
ENABLE_LOCAL_TELEMETRY_READ=true
UNITY_TELEMETRY_DIRECTORY=
