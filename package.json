{
  "name": "tyche-safety-training-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API server for Tyche chemical safety training VR",
  "type": "module",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs",
    "dev": "pm2 start ecosystem.dev.config.cjs --no-daemon",
    "prod": "pm2 start ecosystem.config.cjs",
    "test": "node --test",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:migrate": "node src/db/migrate.js",
    "admin:create": "bash scripts/create-server-admin.sh",
    "viewer:create-temporary": "node scripts/create-temporary-viewer.js",
    "restart": "pm2 restart tyche-safety-training-server --update-env",
    "stop": "pm2 stop tyche-safety-training-server",
    "logs": "pm2 logs tyche-safety-training-server",
    "delete": "pm2 delete tyche-safety-training-server"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.2",
    "pm2": "^7.0.4"
  }
}
